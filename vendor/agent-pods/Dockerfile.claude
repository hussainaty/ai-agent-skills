# In-container Claude pod: the browser-only base + a full Claude Code runtime,
# so the agent runs INSIDE the sandbox and drives the local browser. Layered on
# agent-pod:latest so the plain browser pods stay untouched.
#
#   docker build -t agent-pod:latest .                          # base first
#   docker build -f Dockerfile.claude -t agent-pod-claude:latest .
FROM agent-pod:latest

# Node 22 LTS (Claude Code + agent-browser need Node 18+) + Python 3 (nodriver).
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg git python3 python3-pip \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
       | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" \
       > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Claude Code + agent-browser (Node), pinned to the host versions.
RUN npm install -g @anthropic-ai/claude-code@2.1.195 agent-browser@0.27.1

# nodriver (Python) = raw-CDP driving layer with no Playwright/Puppeteer shim.
# Per the stealth research (gameplan SS9.4) the automation-protocol fingerprint
# is the dominant anti-bot kill; nodriver avoids the shim that gives agent-browser
# /Playwright away. Available for high-detection targets; agent-browser stays the
# easy default for behavioral-detection targets (Reddit etc).
RUN pip3 install --break-system-packages --no-cache-dir nodriver

# Non-root user. Claude Code refuses --dangerously-skip-permissions as root, so
# missions run as `agent`. The browser stack still runs as root via the base
# entrypoint (unchanged).
RUN useradd -m -u 1000 -s /bin/bash agent

# Claude credentials live on the persistent profile mount, so the one-time quota
# login survives pod teardown/recreate (same trick as the browser profile).
ENV CLAUDE_CONFIG_DIR=/data/profile/.claude

# Baked operator manual = working-dir CLAUDE.md, read on every mission.
WORKDIR /work
COPY claude-pod.CLAUDE.md /work/CLAUDE.md
RUN chown -R agent:agent /work

# Wrap the base entrypoint: make the agent's config dir writable on the mount,
# then hand off to the base (Xvfb + browser + CDP + VNC, as root).
COPY entrypoint-claude.sh /entrypoint-claude.sh
RUN chmod +x /entrypoint-claude.sh
ENTRYPOINT ["/entrypoint-claude.sh"]
